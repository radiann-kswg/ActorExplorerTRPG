.root { flex-grow: 1; background-color: #14161c; color: #e6e6e6; font-size: 16px; }
.screen { flex-grow: 1; padding: 16px; display: none; }
.center { align-items: center; justify-content: center; }
.row { flex-direction: row; }
.vcenter { align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; min-width: 0; }
.side { width: 300px; flex-shrink: 0; margin-left: 12px; }
.wide { width: 360px; }
.h1 { font-size: 28px; -unity-font-style: bold; margin-bottom: 12px; }
.h2 { font-size: 18px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 4px; }
.muted { color: #9aa0ad; }
.menu-btn { width: 280px; height: 44px; margin: 6px; font-size: 18px; }
.unity-button { color: #1a1a1a; }
.unity-base-text-field__input, .unity-text-field__input, .unity-base-popup-field__text { color: #111; }
.primary { background-color: #3b6ea8; color: white; }
.grid { flex-direction: row; flex-wrap: wrap; }
.grid > * { width: 150px; margin: 2px; }
.grid .unity-base-field__label { min-width: 70px; width: 70px; }
.grid .unity-base-text-field__input { min-width: 50px; }
.stage { height: 200px; flex-shrink: 0; background-color: #0c0d11; border-radius: 6px; margin-bottom: 10px; }
.background { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.portraits { position: absolute; left: 0; right: 0; bottom: 0; height: 100%; flex-direction: row; justify-content: space-around; align-items: flex-end; }
.portrait { width: 160px; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.log { background-color: #1c1f27; border-radius: 6px; padding: 8px; }
.log-gm { white-space: normal; margin-bottom: 8px; }
.log-player { white-space: normal; margin-bottom: 8px; color: #b9d4ff; }
.log-event { margin-bottom: 8px; padding: 4px 8px; border-left-width: 3px; border-left-color: #ffd591; background-color: rgba(255, 213, 145, 0.08); }
.log-event Label { white-space: normal; color: #ffd591; }
.ev-head { -unity-font-style: bold; }
.ev-roll { color: #e6e6e6; }
.ev-out-Critical { color: #ffe066; -unity-font-style: bold; }
.ev-out-Success { color: #9be27d; -unity-font-style: bold; }
.ev-out-Failure { color: #ff9f9f; -unity-font-style: bold; }
.ev-out-Fumble { color: #ff6b6b; -unity-font-style: bold; }
.log-error { white-space: normal; margin-bottom: 8px; color: #ff8c8c; }
.actor-dd { width: 160px; }
#play-input { min-height: 60px; }
.skill-btn { width: 100%; margin: 1px; -unity-text-align: middle-left; }
.res-label { margin: 2px; }
.modal { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; display: none; }
.modal-box { background-color: #23262f; padding: 16px; border-radius: 8px; width: 320px; }
.modal-box > Button { height: 40px; margin: 4px; }
.actor-item { height: 36px; margin: 2px; -unity-text-align: middle-left; }
.actor-item-selected { background-color: #3b6ea8; color: white; }
